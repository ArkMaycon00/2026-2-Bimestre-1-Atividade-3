{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "Node16",
                            "moduleResolution":  "Node16",
                            "rootDir":  "./src/typescript",
                            "outDir":  "./dist",
                            "esModuleInterop":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "skipLibCheck":  true,
                            "types":  [
                                          "node"
                                      ],
                            "sourceMap":  true,
                            "strict":  true
                        },
    "include":  [
                    "src/typescript/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ]
}
